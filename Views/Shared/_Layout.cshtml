<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexora</title>
    <link rel="icon" type="image/svg+xml" href="~/nexora-icon.svg?v=2" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --nav-bg: #050508;
            --nav-glow: rgba(0, 153, 255, 0.8);
            --nav-text: #d8ebff;
            --footer-bg: #0a0a0c;
        }

        body {
            background-color: #070708;
            color: #eee;
        }

        /* NAVBAR */
        .navbar-custom {
            background: rgba(0, 0, 0, 0.85);
            border-bottom: 1px solid rgba(0, 153, 255, 0.4);
            box-shadow: 0 0 12px rgba(0, 132, 255, 0.55);
            backdrop-filter: blur(8px);
        }

        .navbar-brand {
            font-size: 24px;
            font-weight: 700;
            color: var(--nav-text) !important;
            text-transform: uppercase;
            text-shadow: 0 0 12px rgba(0, 153, 255, 0.9);
            letter-spacing: 1px;
        }

        .navbar-toggler {
            border-color: var(--nav-glow);
        }

        .navbar-toggler-icon {
            filter: brightness(150%);
        }

        /* MAIN CONTAINER */
        .container {
            color: #f0f0f0;
        }

        /* FOOTER */
        footer {
            background: var(--footer-bg);
            border-top: 1px solid rgba(0, 153, 255, 0.3);
            box-shadow: 0 -2px 10px rgba(0, 132, 255, 0.35);
            padding: 10px 0;
            color: #d8ebff;
        }

            footer a {
                color: #78c5ff;
            }

                footer a:hover {
                    text-shadow: 0 0 8px #168cff;
                }
    </style>

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-custom mb-4">
            <div class="container-fluid">

                <!-- BRAND NAME ONLY -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/nexora-icon.svg?v=2" alt="" width="32" height="32" class="me-2" />
                    Nexora
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- EMPTY RIGHT AREA (WE REMOVED HOME & PRIVACY) -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                </div>

            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <!-- GLOBAL THEME TOGGLE -->
        <button id="themeToggle" class="floating-theme-btn" type="button">
            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
        </button>

    </div>


    <footer class="text-center">
        <div class="container">
            © 2025 – Nexora
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
<a href="/Cart/Index" class="cart-floating">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
    </svg>
    <span class="cart-text">Cart</span>
</a>

<style>
    .cart-floating {
        position: fixed;
        bottom: 25px; /* ⬅ নিচে */
        right: 25px; /* ⬅ ডানে */
        background: linear-gradient(135deg, #168cff, #0754c7);
        padding: 12px 22px;
        border-radius: 50px;
        font-size: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #ffffff;
        font-weight: bold;
        text-decoration: none;
        box-shadow: 0 0 15px rgba(0, 153, 255, 0.65);
        z-index: 9999;
        transition: 0.2s ease-in-out;
    }

        .cart-floating:hover {
            transform: scale(1.08);
            background: linear-gradient(135deg, #49adff, #168cff);
        }

    .cart-text {
        font-size: 16px;
        margin-left: 6px;
        color: #ffffff;
        font-weight: 700;
    }
</style>


</html>
