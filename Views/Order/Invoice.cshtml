@model GadgetShop.Models.Order

<style>
    body {
        background: #f8f9fa;
        color: #212529;
    }

    .invoice-container {
        background: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .invoice-title {
        color: #0d6efd;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .invoice-info p {
        margin-bottom: 5px;
        color: #495057;
    }

    table {
        background: #ffffff;
    }

    thead {
        background: #e9ecef;
        color: #212529;
    }

    th, td {
        vertical-align: middle;
    }

    tbody tr:nth-child(even) {
        background: #f8f9fa;
    }

    .total-amount {
        color: #198754;
        font-weight: 600;
        margin-top: 15px;
    }
</style>

<div class="container mt-5">
    <div class="invoice-container">
        <h2 class="invoice-title">Invoice</h2>

        <div class="invoice-info mb-4">
            <p><strong>Order ID:</strong> @Model.Id</p>
            <p><strong>Name:</strong> @Model.CustomerName</p>
            <p><strong>Address:</strong> @Model.Address</p>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td>@i.Name</td>
                        <td class="text-center">@i.Quantity</td>
                        <td class="text-end">@i.UnitPrice</td>
                        <td class="text-end">@i.Total</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="total-amount">Grand Total: ৳ @Model.Total</h4>

        <button onclick="window.print()" class="btn btn-success mt-3">
            <i class="bi bi-printer"></i> Print Invoice
        </button>
    </div>
</div>
