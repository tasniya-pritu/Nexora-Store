@model List<GadgetShop.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<style>
    .cart-wrapper {
        background: rgba(15, 15, 15, 0.85);
        padding: 25px;
        border-radius: 16px;
        border: 1px solid rgba(255,140,0,0.3);
        box-shadow: 0 0 20px rgba(255,140,0,0.15);
        margin-top: 40px;
    }

    .cart-title {
        font-size: 30px;
        font-weight: 800;
        text-align: center;
        color: #ffddaa;
        text-shadow: 0 0 12px rgba(255,140,0,0.8);
        margin-bottom: 20px;
    }

    .cart-table {
        color: #ffdcb3;
        background-color: rgba(10,10,10,0.7);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,140,0,0.25);
    }

        .cart-table thead {
            background: rgba(255,140,0,0.2);
            color: #ffefdd;
        }

        .cart-table td,
        .cart-table th {
            padding: 14px;
            vertical-align: middle;
        }

    .qty-input {
        width: 70px;
        border-radius: 8px;
        background: #222;
        color: #fff;
        border: 1px solid #444;
        text-align: center;
    }

    .btn-remove {
        background: #d9534f;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: bold;
        color: #fff;
        border: none;
    }

    .btn-clear {
        border-radius: 8px;
        padding: 8px 14px;
        font-weight: bold;
        border: 1px solid #ff4444;
        color: #ff4444;
        background: transparent;
    }

    .btn-checkout {
        background: linear-gradient(135deg, #00c853, #00e676);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        color: #001a00;
    }

    .btn-addmore {
        background: linear-gradient(135deg, #ff8c00, #ff5500);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        color: #1a0500;
        box-shadow: 0 0 12px rgba(255,140,0,0.6);
        text-decoration: none;
    }
</style>

<div class="container cart-wrapper">

    <h2 class="cart-title">🛒 Your Shopping Cart</h2>

    <!-- 🔴 LIVE ERROR MESSAGE -->
    <div id="cartError"
         class="alert alert-danger text-center fw-bold"
         style="display:none;">
    </div>

    <!-- 🔴 CHECKOUT ERROR (BACKEND) -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center fw-bold">
            Your cart is empty.
        </div>

        <div class="text-center mt-3">
            <a href="/Home/Index" class="btn-addmore">Add More to Cart →</a>
        </div>
    }
    else
    {
        <table class="table cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th width="140">Price</th>
                    <th width="140">Qty</th>
                    <th width="140">Total</th>
                    <th width="80"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>৳ @item.UnitPrice</td>

                        <!-- ✅ AUTO UPDATE INPUT -->
                        <td>
                            <input type="number"
                                   class="qty-input"
                                   value="@item.Quantity"
                                   min="1"
                                   data-product="@item.ProductId" />
                        </td>

                        <td>৳ @item.Total</td>

                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="btn btn-remove">✖</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-3">

            <form asp-action="Clear" method="post">
                <button class="btn-clear">Clear Cart</button>
            </form>

            <a href="/Home/Index" class="btn-addmore">+ Add More to Cart</a>

            <a class="btn-checkout" asp-action="Checkout">
                Proceed to Checkout →
            </a>
        </div>
    }
</div>

<!-- ⚡ AUTO UPDATE SCRIPT -->
<script>document.querySelectorAll(".qty-input").forEach(input => {
        input.addEventListener("change", function () {

            const qty = this.value;
            const productId = this.dataset.product;

            fetch("/Cart/UpdateAjax", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `productId=${productId}&qty=${qty}`
            })
            .then(res => res.json())
            .then(data => {
                const errBox = document.getElementById("cartError");

                if (!data.success) {
                    errBox.innerText = data.message;
                    errBox.style.display = "block";
                } else {
                    errBox.style.display = "none";
                    location.reload();
                }
            });
        });
    });</script>
