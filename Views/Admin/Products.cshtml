@model IEnumerable<GadgetShop.Models.Product>

<div class="container mt-5">
    <h2 class="mb-3 text-white">Admin Products</h2>

    <a href="/admin/create" class="btn btn-primary mb-3">Add New Product</a>

    <table class="table table-dark table-bordered table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Name</th>
                <th>Cat</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>

                <th width="180">Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>
                        <img src="@p.Image" width="60" height="60" style="object-fit:cover;border-radius:5px;" />
                    </td>
                    <td>@p.Name</td>
                    <td>@p.Category</td>
                    <td>৳ @p.Price</td>
                    <td>@p.Stock</td>

                    <td>
                        <a href="/admin/edit/@p.Id" class="btn btn-warning btn-sm">Edit</a>

                        <form action="/admin/delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure delete this?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
                <tr class="@(p.Stock == 0 ? "table-danger" : p.Stock <= 5 ? "table-warning" : "")">
                    <td>@p.Name</td>
                    <td>@p.Stock</td>

                    <td>
                        @if (p.Stock == 0)
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                        else if (p.Stock <= 5)
                        {
                            <span class="badge bg-warning text-dark">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">In Stock</span>
                        }
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>
